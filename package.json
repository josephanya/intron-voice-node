{
  "name": "@intron-voice-node",
  "version": "0.0.0",
  "description": "Node.js SDK for the Intron Voice API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pretest": "npm run build",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "test": "vitest run",
    "test:contract": "vitest run test/contract.test.ts",
    "test:live": "vitest run test/live-smoke.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "intron",
    "voice",
    "speech-to-text",
    "text-to-speech",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^20.19.11",
    "@types/ws": "^8.18.1",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
